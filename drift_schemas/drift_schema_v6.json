    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NULL, \"category_id\" TEXT NULL, \"frequency_type\" TEXT NOT NULL, \"target_days_of_week\" TEXT NULL, \"target_count_per_week\" INTEGER NULL, \"interval_hours\" INTEGER NULL, \"times_per_day\" INTEGER NULL, \"time_window\" TEXT NULL, \"target_type\" TEXT NOT NULL, \"target_value\" REAL NULL, \"unit\" TEXT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"reminder_times\" TEXT NOT NULL DEFAULT '[]', \"motivation_notes\" TEXT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"prompt_reflection\" INTEGER NOT NULL DEFAULT 0 CHECK (\"prompt_reflection\" IN (0, 1)), \"health_metric\" TEXT NULL, \"health_sync_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"health_sync_enabled\" IN (0, 1)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"interval_index\" INTEGER NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"value\" REAL NULL, \"duration_seconds\" INTEGER NULL, \"note\" TEXT NULL, \"energy_level\" INTEGER NULL, \"mood\" TEXT NULL, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_shields",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_shields\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"auto_applied\" INTEGER NOT NULL DEFAULT 0 CHECK (\"auto_applied\" IN (0, 1)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
