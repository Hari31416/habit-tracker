#!/usr/bin/env bash
set -e

# Full gate on push: analyze + coverage + floor.
# This is the enforcement point; pre-commit stays fast by default.
# Skip with: SKIP_HOOK=1 git push  or  git push --no-verify

if [[ "$SKIP_HOOK" == "1" || "$SKIP_PRE_PUSH" == "1" ]]; then
  echo "Skipping pre-push checks (SKIP_HOOK=1)."
  exit 0
fi

echo "=========================================="
echo " Running Pre-Push Checks (FULL)"
echo "=========================================="

echo "--> Step 1/3: Checking Dart/Flutter analysis (lint)..."
flutter analyze

echo "--> Step 2/3: Running unit and widget tests with coverage..."
flutter test --coverage

echo "--> Step 3/3: Verifying domain+data coverage floor..."
python3 scripts/check_domain_data_coverage.py

echo "=========================================="
echo " Pre-Push Checks Passed!"
echo "=========================================="
