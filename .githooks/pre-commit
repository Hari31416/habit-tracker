#!/usr/bin/env bash
set -e

# Fast by default: analyze + test (no coverage) ~6s vs 15-18s.
# Full gate (with coverage) runs in pre-push + CI, or on demand:
#   HOOK_FULL=1 git commit
#   .githooks/pre-commit --full
#   make check-full
# Skip entirely:
#   SKIP_HOOK=1 git commit
#   git commit --no-verify
# Docs-only commits auto-skip tests.

if [[ "$SKIP_HOOK" == "1" || "$SKIP_PRE_COMMIT" == "1" ]]; then
  echo "Skipping pre-commit checks (SKIP_HOOK=1)."
  exit 0
fi

FULL=0
if [[ "$HOOK_FULL" == "1" || "$1" == "--full" || "$1" == "full" ]]; then
  FULL=1
fi

# Auto-skip heavy tests when only docs/markdown/plans changed
CHANGED="$(git diff --cached --name-only 2>/dev/null || true)"
if [[ -z "$CHANGED" ]]; then
  CHANGED="$(git diff --name-only 2>/dev/null || true)"
fi
if [[ -n "$CHANGED" ]] && ! echo "$CHANGED" | grep -qE '^(lib/|test/|pubspec\.yaml|pubspec\.lock|analysis_options\.yaml)'; then
  echo "No Dart/code changes detected — skipping tests (only docs/config changed)."
  echo "Changed files:"
  echo "$CHANGED" | sed 's/^/  - /'
  # still run analyze on Dart? Skip it too since no Dart changed
  echo "Pre-Commit Checks Skipped (docs-only)."
  exit 0
fi

if [[ $FULL == 1 ]]; then
  echo "=========================================="
  echo " Running Pre-Commit Checks (FULL)"
  echo "=========================================="
else
  echo "=========================================="
  echo " Running Pre-Commit Checks (FAST)"
  echo " Tip: HOOK_FULL=1 git commit  or  make check-full  for coverage gate"
  echo "      SKIP_HOOK=1 git commit  or  --no-verify to skip"
  echo "=========================================="
fi

echo "--> Step 1: Checking Dart/Flutter analysis (lint)..."
flutter analyze

if [[ $FULL == 1 ]]; then
  echo "--> Step 2/3: Running unit and widget tests with coverage..."
  flutter test --coverage

  echo "--> Step 3/3: Verifying domain+data coverage floor..."
  python3 scripts/check_domain_data_coverage.py
else
  echo "--> Step 2: Running unit and widget tests (no coverage)..."
  flutter test
fi

echo "=========================================="
echo " Pre-Commit Checks Passed! (mode: $([[ $FULL == 1 ]] && echo FULL || echo FAST))"
echo "=========================================="
