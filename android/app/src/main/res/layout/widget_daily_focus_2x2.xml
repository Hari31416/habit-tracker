<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#F1F5F4"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Big Ratio: 3/5 -->
    <TextView
        android:id="@+id/tv_progress_ratio_2x2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0/0"
        android:textColor="#10B981"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Completed Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="completed"
        android:textColor="#9EADA9"
        android:textSize="11sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_daily_progress_2x2"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar_drawable" />

    <!-- Remaining Text: 2 left -->
    <TextView
        android:id="@+id/tv_remaining_2x2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 left"
        android:textColor="#9EADA9"
        android:textSize="11sp" />

</LinearLayout>
