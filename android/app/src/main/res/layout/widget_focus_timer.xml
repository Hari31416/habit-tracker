<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#162320"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/ll_timer_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_timer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Focus Session"
            android:textColor="#F1F5F4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_timer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Countdown & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_timer_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25:00"
            android:textColor="#10B981"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_timer_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#10B981"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#061210"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_timer_reset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="#20332E"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="#9EADA9"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_timer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#10B981" />

</LinearLayout>
