<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_streak_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="4dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp">

    <!-- Habit Title Column -->
    <TextView
        android:id="@+id/tv_streak_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Habit Title"
        android:textColor="#F1F5F4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 7-Day Dots Indicator -->
    <ImageView
        android:id="@+id/iv_streak_dots"
        android:layout_width="70dp"
        android:layout_height="12dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:contentDescription="Streak dots" />

    <!-- Streak Count -->
    <TextView
        android:id="@+id/tv_streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0d"
        android:textColor="#F59E0B"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
