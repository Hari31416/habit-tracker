<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- Top Section (Badge + Level Info) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hexagon Badge -->
        <ImageView
            android:id="@+id/iv_level_shield_2x4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Level badge" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Level Label & XP Ratio Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_level_name_2x4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Level 1"
                    android:textColor="#F1F5F4"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_xp_ratio_2x4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XP / 100"
                    android:textColor="#F1F5F4"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rank Title -->
            <TextView
                android:id="@+id/tv_rank_title_2x4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novice"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/pb_xp_progress_2x4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_bar_drawable" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row (Needed XP + Badges) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_xp_needed_2x4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 XP to Level 2"
            android:textColor="#9EADA9"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_badges_count_2x4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 0/0 Badges"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
