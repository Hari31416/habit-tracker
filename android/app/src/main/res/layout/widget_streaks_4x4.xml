<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/ll_streaks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active Streaks"
            android:textColor="#F1F5F4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_active_streaks_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Active"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_streaks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No active streaks yet\nComplete habits today to build your streak"
        android:textColor="#9EADA9"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Dynamic Container for Streak Habits -->
    <LinearLayout
        android:id="@+id/ll_streaks_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- Bottom Metrics -->
    <LinearLayout
        android:id="@+id/ll_streaks_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_bottom_overall_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Top overall streak: 0 days"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
