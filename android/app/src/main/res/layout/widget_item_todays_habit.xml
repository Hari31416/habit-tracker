<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="4dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp">

    <!-- Checkmark Icon Circle -->
    <TextView
        android:id="@+id/tv_habit_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:gravity="center"
        android:text="○"
        android:textColor="#9EADA9"
        android:textSize="13sp" />

    <!-- Habit Title -->
    <TextView
        android:id="@+id/tv_habit_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Habit Title"
        android:textColor="#F1F5F4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Streak Badge -->
    <TextView
        android:id="@+id/tv_habit_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        android:text=""
        android:textColor="#F59E0B"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
